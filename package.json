{
  "name": "curtainwall-panel-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "浏览器端幕墙分格与反射检查系统 (TypeScript + WebGPU)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "node scripts/gpu-e2e.cjs",
    "bench": "vitest run --testNamePattern bench"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.51",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "webgpu": "^0.6.2"
  }
}
